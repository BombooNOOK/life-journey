{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:vercel",
  "functions": {
    "src/app/api/orders/*/pdf/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/journal/backup/route.ts": {
      "maxDuration": 300
    }
  },
  "git": {
    "deploymentEnabled": {
      "preview/x67-identity-safety": false
    }
  }
}
