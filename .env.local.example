# ⚠️ このファイルは「見本」です。編集してもアプリには反映されません。
# 実際に設定するのは `.env.local` です（Cmd+P → 「env local」と入力 → .example なしを選ぶ）。
# このファイルを `.env.local` にコピーして値を埋めてください（Git に上げない）

# ── DB 切り替え ─────────────────────────────────────────────
# Prisma / Next は `DATABASE_URL` だけを参照します。
# 開発中はローカル、本番確認前だけ Neon に差し替えてください。

# ローカル Postgres（docker compose up 後）
DATABASE_URL="postgresql://ljd:ljd_local_dev@127.0.0.1:5433/ljd_dev?schema=public"

# Neon（本番・最終確認用。普段はコメントアウト推奨）
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# 参考用（スクリプトでは未使用。切り替えは DATABASE_URL を書き換える）
# DATABASE_URL_LOCAL="postgresql://ljd:ljd_local_dev@127.0.0.1:5433/ljd_dev?schema=public"
# DATABASE_URL_NEON="postgresql://..."

# ── Firebase（必須）────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Stripe Billing（月額プラン）──────────────────────────────
# sk_ / whsec_ は Git に含めない。Dashboard または `stripe listen` から取得
# 重要: sk_test_ にはテストモードの price ID、sk_live_ には本番モードの price ID を使う
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_LIGHT=price_...   # Dashboard 右上「テストモード」ON の Products からコピー
# STRIPE_PRICE_STANDARD=price_...
# STRIPE_PRICE_LIGHT=price_...   # テストモード Dashboard の Products から
# STRIPE_PRICE_STANDARD=price_...
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
# ローカル Webhook: stripe listen --forward-to localhost:3000/api/stripe/webhook

# ── Capacitor v0.1 検証（WebView 先 URL）────────────────────
# npm run cap:sync 実行時にシェルから渡すのが基本。ここはメモ用。
# CAPACITOR_SERVER_URL=http://127.0.0.1:3000
# Android エミュレータ: CAPACITOR_SERVER_URL=http://10.0.2.2:3000
# Vercel Preview: CAPACITOR_SERVER_URL=https://your-preview.vercel.app
