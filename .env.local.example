# ⚠️ このファイルは「見本」です。編集してもアプリには反映されません。
# 実際に設定するのは `.env.local` です（Cmd+P → 「env local」と入力 → .example なしを選ぶ）。
# このファイルを `.env.local` にコピーして値を埋めてください（Git に上げない）

# ── DB 切り替え ─────────────────────────────────────────────
# Prisma / Next は `DATABASE_URL` だけを参照します。
# 開発中はローカル、本番確認前だけ Neon に差し替えてください。

# ローカル Postgres（docker compose up 後）
DATABASE_URL="postgresql://ljd:ljd_local_dev@127.0.0.1:5433/ljd_dev?schema=public"

# Neon（本番・最終確認用。普段はコメントアウト推奨）
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# 参考用（スクリプトでは未使用。切り替えは DATABASE_URL を書き換える）
# DATABASE_URL_LOCAL="postgresql://ljd:ljd_local_dev@127.0.0.1:5433/ljd_dev?schema=public"
# DATABASE_URL_NEON="postgresql://..."

# ── Firebase（必須）────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Stripe（test / live 混在禁止。本番販売はまだ開始しない）──
# STRIPE_MODE=test
# STRIPE_CHECKOUT_ENABLED=false
# STRIPE_SECRET_KEY_TEST=sk_test_...
# STRIPE_WEBHOOK_SECRET_TEST=whsec_...
# STRIPE_PRICE_FOREST_DELIVERY_TEST=price_...
# STRIPE_PRICE_ACORN_50_TEST=price_...
# 互換（旧）: STRIPE_SECRET_KEY / STRIPE_PRICE_LIGHT / STRIPE_PRICE_STANDARD
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
# ローカル Webhook: stripe listen --forward-to localhost:3000/api/stripe/webhook

# ── Capacitor Phase 4B-1（検証専用・本番URL固定禁止）────────────────
# iOS Simulator / Preview 用の WebView 先。未設定時は cap-sync が 127.0.0.1:3000 を使う。
# 最終 Local-first Hybrid では remote URL 前提にしない（docs/hybrid/HYBRID_PHASE_4B1_IOS_SHELL.md）。
# CAPACITOR_SERVER_URL=http://127.0.0.1:3000
# CAPACITOR_SERVER_URL=https://your-preview.vercel.app

# ── Local Runtime E2E harness (AI-5.2・local disposable only) ──
# Never enable on Production / Preview / Neon. Do not commit real secrets.
# LJD_ENABLE_LOCAL_E2E_HARNESS=YES
# LJD_LOCAL_E2E_ACTOR_EMAIL=local-e2e-actor@ljd.local
# LJD_JOURNAL_SAVE_IDEMPOTENCY_ENABLED=YES

# Native stable pending-intent identity (AI-X6.6 / device validation only).
# Client/Capacitor WebView requires the NEXT_PUBLIC_ form (default OFF).
# Do NOT enable on Production Vercel. Do NOT enable Production stable JSO flags.
# NEXT_PUBLIC_LJD_NATIVE_STABLE_PENDING_INTENT_ENABLED=YES

# アカウント削除で Firebase ログイン情報も消す場合（本番必須・ローカルは任意）
# FIREBASE_SERVICE_ACCOUNT_JSON=
