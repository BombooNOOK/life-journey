# このファイルをコピーして `.env.local` にリネームし、
# 右側の値を Firebase コンソールの「ウェブアプリの設定」から貼ってください。
# （.env.local は Git に上げないので安心です）

# DB 接続先（Prisma は DATABASE_URL のみ参照）
# ローカル開発: docs/DEV_DATABASE.md と .env.local.example を参照
# 例（ローカル Postgres）: postgresql://ljd:ljd_local_dev@127.0.0.1:5433/ljd_dev?schema=public
# 例（Neon 本番確認）: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Neon + Vercel ではプーラー用 URL 推奨
DATABASE_URL=

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# あれば（なくても動きます）
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# 日記製本 BASE 商品 URL（ページ数で自動切替）。未設定時は下記 BambooNOOK 本番 URL。
# NEXT_PUBLIC_DIARY_BOOK_TRIAL_URL=https://bamboonook.base.shop/items/144971389   # 1〜50ページ
# NEXT_PUBLIC_DIARY_BOOK_LIGHT_URL=https://bamboonook.base.shop/items/144984479   # 51〜100ページ
# NEXT_PUBLIC_DIARY_BOOK_STANDARD_URL=https://bamboonook.base.shop/items/144985541
# NEXT_PUBLIC_DIARY_BOOK_FULL_YEAR_URL=https://bamboonook.base.shop/items/144984751
# （旧名 NEXT_PUBLIC_BASE_BOOK_* もフォールバックで参照されます）
# 鑑定書PDFの無料回数超過時に案内する再発行商品ページ（任意）
# NEXT_PUBLIC_BASE_PDF_REISSUE_URL=

# 月額ライトプラン（定期便）・鑑定書製本版（単発）の BASE 商品 URL
# NEXT_PUBLIC_BASE_LIGHT_SUBSCRIPTION_URL=https://bamboonook.base.shop/items/144880129
# NEXT_PUBLIC_BASE_KANTEI_BOOK_URL=https://bamboonook.base.shop/items/144880008
# NEXT_PUBLIC_BASE_STANDARD_SUBSCRIPTION_URL=

# Stripe Billing（月額プラン・Checkout）。sk_ / whsec_ は Git に含めない
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_LIGHT=price_...
# STRIPE_PRICE_STANDARD=price_...
# ローカル Webhook: stripe listen --forward-to localhost:3000/api/stripe/webhook
# NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# 新規登録完了メール（任意・Resend）。未設定時は画面案内のみ表示
# RESEND_API_KEY=
# RESEND_FROM=BambooNOOK <noreply@mail.yourdomain.jp>
# 送信完了画面に表示する想定送信元（任意・上記と同じで可）
# NEXT_PUBLIC_TRANSACTIONAL_EMAIL_FROM=BambooNOOK <noreply@mail.yourdomain.jp>
# Firebase パスワード再設定は Resend SMTP を Console で設定（docs/EMAIL_DELIVERABILITY_SETUP.md 参照）

# 管理者用メール（カンマ区切り）。/admin ページへのアクセス許可に使います。
# ADMIN_EMAILS=owner@example.com,staff@example.com

# Vercel Blob（鑑定 PDF キャッシュ用・既存 Store。変更しない）
# BLOB_READ_WRITE_TOKEN=

# Journal photo Blob Store（Private・鑑定 PDF とは別 Store）
# Vercel Storage → 日記 Store → Info の BLOB_STORE_ID をコピー
JOURNAL_PHOTO_BLOB_STORE_ID=
# Vercel 本番: VERCEL_OIDC_TOKEN は自動注入（手動不要）
# ローカル: vercel env pull で VERCEL_OIDC_TOKEN を取得
# Optional local fallback（OIDC が使えない場合のみ）
# JOURNAL_PHOTO_BLOB_READ_WRITE_TOKEN=

